# Copia este archivo a .env y ajusta los valores.
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/porfolio

# Sesiones (cambia por un valor largo y aleatorio en producción)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Admin inicial que crea el seed (cámbialo tras el primer login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
