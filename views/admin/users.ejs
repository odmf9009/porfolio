<%- include('../partials/admin-header', { active: 'users' }) %>

<div class="page__head">
  <div><h1>Usuarios</h1><p class="muted">Gestiona quién puede entrar al panel.</p></div>
</div>

<% if (error) { %><p class="alert"><%= error %></p><% } %>

<section class="card">
  <h2>Nuevo usuario</h2>
  <form action="/admin/users" method="post" class="form form--grid">
    <label>Usuario<input type="text" name="username" required /></label>
    <label>Contraseña (mín. 6)<input type="password" name="password" required /></label>
    <label>Rol
      <select name="role">
        <option value="editor">editor (solo proyectos)</option>
        <option value="admin">admin (proyectos + usuarios)</option>
      </select>
    </label>
    <div class="form__actions"><button class="btn btn--primary">Crear usuario</button></div>
  </form>
</section>

<div class="list">
  <% users.forEach(function(u){ %>
  <div class="row">
    <div class="row__main">
      <div class="row__title"><%= u.username %> <span class="pill"><%= u.role %></span> <% if (u._id.toString() === currentUser._id.toString()) { %><span class="pill pill--muted">tú</span><% } %></div>
      <div class="row__sub muted">creado <%= new Date(u.createdAt).toLocaleDateString('es') %></div>
    </div>
    <div class="row__actions">
      <form action="/admin/users/<%= u._id %>/password" method="post" class="inline">
        <input type="password" name="password" placeholder="nueva contraseña" minlength="6" />
        <button class="btn btn--sm">Cambiar</button>
      </form>
      <% if (u._id.toString() !== currentUser._id.toString()) { %>
      <form action="/admin/users/<%= u._id %>/delete" method="post" data-confirm="¿Eliminar a <%= u.username %>?">
        <button class="btn btn--sm btn--danger">Eliminar</button>
      </form>
      <% } %>
    </div>
  </div>
  <% }) %>
</div>

<%- include('../partials/admin-footer') %>
